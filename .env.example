# =============================================================================
# Trendz API — environment variables
# Copy to .env and fill in. Never commit .env files.
# Values below are safe placeholders for LOCAL development with docker compose.
# =============================================================================

NODE_ENV=development
PORT=4100
# Public origin of the web app (used in emails, redirects and CORS)
WEB_URL=http://localhost:3100
# Extra origins allowed to call the API cross-origin (comma separated).
# Browsers normally reach the API through the web origin, so this can stay empty.
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Cloudflare + Nginx = 2; the web app on
# Vercel in front of the API on Render = 3)
TRUST_PROXY=1
LOG_LEVEL=info
# true = the API process also runs the background jobs (emails and SMS, image sizes,
# invoices, releasing unpaid orders …), and the separate worker is not started. For a
# host that runs one process, such as Render's free plan. Leave empty otherwise.
RUN_WORKER_IN_API=

# --- Database & cache --------------------------------------------------------
# The application's database. Locally: the PostgreSQL on this machine.
DATABASE_URL=postgresql://trendz:trendz_local_pw@127.0.0.1:5432/trendz?schema=public&connect_timeout=30
# On Supabase (hosted PostgreSQL) use the session pooler string instead (project →
# Connect, port 5432), ending in
#   ?schema=public&connection_limit=5&connect_timeout=30
# The API and the worker are long-running, so the session pooler suits them; the
# transaction pooler (port 6543) is not used. After the first `npm run db:deploy`
# the tables are closed to Supabase's own REST API (scripts/db-lockdown.ts).
#
# When DATABASE_URL is a hosted database, this is the PostgreSQL on this machine
# that `npm run db:migrate` writes new migrations against (never the hosted one).
LOCAL_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6390/0

# --- Auth --------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to true in production (HTTPS only)
COOKIE_SECURE=false
# Leave empty for host-only cookies
COOKIE_DOMAIN=

# --- Payments: Razorpay ------------------------------------------------------
# razorpay | mock | none   (mock is refused when NODE_ENV=production)
# none = no gateway connected yet: the shop takes no online orders and the billing
# counter no gateway payments. Nothing is simulated.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Image storage -------------------------------------------------------------
# r2 | cloudinary. Every picture of the application (products, categories,
# brands, home page and About pictures) is kept by the service chosen here.
STORAGE_PROVIDER=r2

# Cloudflare R2 (S3 compatible), when STORAGE_PROVIDER=r2.
# For R2: R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Locally this points at the MinIO container.
R2_ACCOUNT_ID=
R2_ENDPOINT=http://localhost:9100
R2_ACCESS_KEY_ID=trendz_minio
R2_SECRET_ACCESS_KEY=trendz_minio_secret
R2_BUCKET_NAME=trendz-media
# Public base URL that serves objects under the "public/" prefix
# (R2 custom domain, e.g. https://media.example.com). Locally: MinIO bucket URL.
R2_PUBLIC_URL=http://localhost:9100/trendz-media
R2_FORCE_PATH_STYLE=true

# Cloudinary, when STORAGE_PROVIDER=cloudinary. From the Cloudinary console →
# Settings → API Keys: either the one line shown there as "API environment
# variable" (cloudinary://<api key>:<api secret>@<cloud name>) in CLOUDINARY_URL,
# or the three values. The API secret is used only by the API, never by the browser.
# Locally they can also be kept in a separate file, .env.keys, which the
# API reads together with .env (never committed).
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder in the Cloudinary account that holds this environment's pictures. Use a
# different one for each environment that shares the account (trendz for production).
CLOUDINARY_FOLDER=trendz-dev
# sha1 unless the account's signature algorithm was changed (Settings → Security).
CLOUDINARY_SIGNATURE_ALGORITHM=sha1
# After filling these in: npm run storage:check   (and npm run storage:migrate to
# move pictures that are already on R2 / MinIO).

# --- SMS ---------------------------------------------------------------------
# msg91 | console   (console is refused when NODE_ENV=production)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
# MSG91 DLT template ids (one per message type)
SMS_TEMPLATE_OTP=
SMS_TEMPLATE_ORDER=
SMS_TEMPLATE_SHIPPING=

# --- Email -------------------------------------------------------------------
# brevo | ses | smtp
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=orders@trendz.local
EMAIL_FROM_NAME=Trendz
# Amazon SES (when EMAIL_PROVIDER=ses)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SMTP (local Mailpit by default)
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Shipping: Shiprocket ----------------------------------------------------
# shiprocket | mock | none   (mock is refused when NODE_ENV=production)
# none = no courier service connected yet: shipments are entered by hand.
SHIPPING_PROVIDER=mock
# Shiprocket API user email / password
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
# Shiprocket pickup location nickname configured in the Shiprocket panel
SHIPPING_PICKUP_LOCATION=Primary
# Token Shiprocket sends in the x-api-key header of webhook calls
SHIPPING_WEBHOOK_TOKEN=

# --- Bootstrap (seed) --------------------------------------------------------
SEED_ADMIN_EMAIL=admin@trendz.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
OPENAI_API_KEY=

# AI-assisted product draft generation (server-side only)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
