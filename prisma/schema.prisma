// =============================================================================
// Trendz — PostgreSQL schema
//
// Conventions
//   * Tables and columns are snake_case in PostgreSQL (@@map / @map).
//   * All money values are integers in the smallest currency unit (paise).
//     ₹799.00 is stored as 79900. Never use floats for money.
//   * Percentages are stored in basis points (bps): 18% = 1800.
//   * Business documents (orders, invoices, credit notes) store immutable
//     snapshots of names, prices, taxes and addresses at the time they were
//     created, so later catalog edits never rewrite history.
//   * Every stock change writes an inventory_transactions row (ledger).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, citext]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  VERIFY_EMAIL
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DISCONTINUED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ImageStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

enum CodeType {
  QR
  EAN13
  UPC
  CODE128
}

enum CodeStatus {
  ACTIVE
  INACTIVE
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum StockBucket {
  ON_HAND
  RESERVED
  DAMAGED
  RETURNED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  REFUND
  DAMAGE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  STOCK_CORRECTION
  RESERVATION
  RESERVATION_RELEASE
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum AdjustmentReason {
  COUNT_CORRECTION
  DAMAGE
  LOSS
  FOUND
  EXPIRED
  OPENING_STOCK
  OTHER
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  ALL
  PRODUCTS
  CATEGORIES
  BRANDS
}

enum SalesChannel {
  ONLINE
  POS
}

enum ChannelScope {
  ALL
  ONLINE
  POS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  CASH
  UPI_MANUAL
  CARD_MANUAL
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ShipmentStatus {
  NOT_REQUIRED
  PENDING
  CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  RETURN_TO_ORIGIN
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  CLOSED
  CANCELLED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  DEFECTIVE
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PosCartStatus {
  OPEN
  CHECKED_OUT
  ABANDONED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// -----------------------------------------------------------------------------
// Users, authentication & sessions
// -----------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String?    @unique @db.Citext
  phone              String?    @unique // E.164, e.g. +919876543210
  passwordHash       String?    @map("password_hash")
  status             UserStatus @default(ACTIVE)
  isStaff            Boolean    @default(false) @map("is_staff")
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  phoneVerifiedAt    DateTime?  @map("phone_verified_at")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  lastLoginAt        DateTime?  @map("last_login_at")
  defaultWarehouseId String?    @map("default_warehouse_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  profile            UserProfile?
  addresses          Address[]
  sessions           UserSession[]
  roles              UserRole[]          @relation("UserRoles")
  rolesAssigned      UserRole[]          @relation("RoleAssigner")
  verificationTokens VerificationToken[]
  cart               Cart?
  wishlist           WishlistItem[]
  reviews            ProductReview[]
  orders             Order[]             @relation("CustomerOrders")
  ordersCreated      Order[]             @relation("OrderCreator")
  notifications      Notification[]
  auditLogs          AuditLog[]
  defaultWarehouse   Warehouse?          @relation(fields: [defaultWarehouseId], references: [id])
  returnRequests     ReturnRequest[]     @relation("ReturnCustomer")
  couponRedemptions  CouponRedemption[]

  @@index([createdAt])
  @@index([status])
  @@map("users")
}

model UserProfile {
  userId         String    @id @map("user_id") @db.Uuid
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  avatarKey      String?   @map("avatar_key")
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         String?
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Address {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  label             String?
  fullName          String   @map("full_name")
  phone             String
  line1             String
  line2             String?
  landmark          String?
  city              String
  state             String
  stateCode         String   @map("state_code") // GST state code, e.g. "33" for Tamil Nadu
  postalCode        String   @map("postal_code")
  country           String   @default("IN")
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model UserSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  // Hash of the refresh token that was rotated out. If it is ever presented
  // again the session is revoked (refresh-token reuse = likely theft).
  previousTokenHash String?   @map("previous_token_hash")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousTokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  userId     String?  @map("user_id") @db.Uuid
  method     String // PASSWORD | OTP
  success    Boolean
  reason     String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  identifier  String // phone (E.164) or email
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") // HMAC-SHA256, never plaintext
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([identifier, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

// -----------------------------------------------------------------------------
// RBAC
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // SUPER_ADMIN, ADMIN, ...
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // e.g. "products.write"
  module      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  imageKey       String?  @map("image_key")
  imageUrl       String?  @map("image_url")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  depth          Int      @default(0)
  // Materialised path of ancestor ids: "/<rootId>/<childId>/" — lets us fetch a
  // whole subtree with a single indexed LIKE 'prefix%' query.
  path           String   @default("/")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String?  @map("seo_keywords")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent    Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]       @relation("CategoryTree")
  products  Product[]
  coupons   CouponCategory[]
  discounts DiscountTarget[]

  @@index([parentId, sortOrder])
  @@index([path])
  @@index([isActive])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  logoKey     String?  @map("logo_key")
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products  Product[]
  discounts DiscountTarget[]

  @@map("brands")
}

model TaxClass {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rates    TaxRate[]
  products Product[]

  @@map("tax_classes")
}

// A tax class has one or more rates. A rate can be limited to a unit-price
// slab (e.g. apparel GST depends on the per-piece transaction value) and to an
// effective date range, so rate changes never require code changes.
model TaxRate {
  id            String    @id @default(uuid()) @db.Uuid
  taxClassId    String    @map("tax_class_id") @db.Uuid
  rateBps       Int       @map("rate_bps") // 1800 = 18%
  minUnitPrice  Int?      @map("min_unit_price") // paise, inclusive
  maxUnitPrice  Int?      @map("max_unit_price") // paise, inclusive
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  taxClass TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)

  @@index([taxClassId, effectiveFrom])
  @@map("tax_rates")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  baseSku          String        @unique @map("base_sku") // style code; variants carry the sellable SKUs
  description      String?
  shortDescription String?       @map("short_description")
  categoryId       String        @map("category_id") @db.Uuid
  brandId          String?       @map("brand_id") @db.Uuid
  productType      String?       @map("product_type")
  status           ProductStatus @default(DRAFT)
  mrp              Int // list price ("price"), paise
  sellingPrice     Int           @map("selling_price")
  costPrice        Int?          @map("cost_price")
  taxClassId       String?       @map("tax_class_id") @db.Uuid
  hsnCode          String?       @map("hsn_code")
  minStockLevel    Int           @default(0) @map("min_stock_level")
  weightGrams      Int?          @map("weight_grams")
  lengthMm         Int?          @map("length_mm")
  widthMm          Int?          @map("width_mm")
  heightMm         Int?          @map("height_mm")
  tags             String[]      @default([])
  isFeatured       Boolean       @default(false) @map("is_featured")
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  seoKeywords      String?       @map("seo_keywords")
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxClass       TaxClass?        @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  options        ProductOption[]
  variants       ProductVariant[]
  images         ProductImage[]
  codes          ProductCode[]
  wishlistItems  WishlistItem[]
  reviews        ProductReview[]
  couponProducts CouponProduct[]
  discounts      DiscountTarget[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, createdAt])
  @@index([sellingPrice])
  @@index([createdAt])
  @@index([tags], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String // e.g. Size, Color
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  value    String // e.g. M, Red
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id                String        @id @default(uuid()) @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  sku               String        @unique
  title             String // "Red / M"
  mrp               Int
  sellingPrice      Int           @map("selling_price")
  costPrice         Int?          @map("cost_price")
  weightGrams       Int?          @map("weight_grams")
  lengthMm          Int?          @map("length_mm")
  widthMm           Int?          @map("width_mm")
  heightMm          Int?          @map("height_mm")
  lowStockThreshold Int?          @map("low_stock_threshold") // falls back to product.min_stock_level
  status            VariantStatus @default(ACTIVE)
  isDefault         Boolean       @default(false) @map("is_default")
  position          Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  product            Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues       VariantOptionValue[]
  images             ProductImage[]
  codes              ProductCode[]
  inventoryLevels    InventoryLevel[]
  inventoryTxns      InventoryTransaction[]
  reservations       StockReservation[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]
  adjustmentItems    StockAdjustmentItem[]
  posCartItems       PosCartItem[]
  receiptItems       GoodsReceiptItem[]
  returnItems        ReturnItem[]

  @@index([productId, position])
  @@index([status])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_variants_sku_trgm_idx")
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

// Images live in Cloudflare R2. PostgreSQL only stores keys and metadata.
model ProductImage {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @map("product_id") @db.Uuid
  variantId String?     @map("variant_id") @db.Uuid
  objectKey String      @map("object_key") // upload key (on R2 the file is deleted after optimisation; Cloudinary keeps it and makes the sizes from it)
  url       String? // primary (large WebP) public URL
  altText   String?     @map("alt_text")
  sortOrder Int         @default(0) @map("sort_order")
  width     Int?
  height    Int?
  // { thumb: {key,url,width,height}, medium: {...}, large: {...}, avif?: {...} }
  sizes     Json?
  mimeType  String?     @map("mime_type")
  bytes     Int?
  status    ImageStatus @default(PENDING_UPLOAD)
  error     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@index([status])
  @@map("product_images")
}

// QR / barcode identifiers. A code always resolves to exactly one variant (SKU).
// A code identifies a product — it never represents a quantity.
model ProductCode {
  id          String     @id @default(uuid()) @db.Uuid
  productId   String     @map("product_id") @db.Uuid
  variantId   String     @map("variant_id") @db.Uuid
  sku         String // denormalised copy of product_variants.sku, kept in sync
  codeType    CodeType   @map("code_type")
  codeValue   String     @unique @map("code_value")
  qrPayload   String?    @map("qr_payload")
  status      CodeStatus @default(ACTIVE)
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([sku])
  @@index([codeType])
  @@map("product_codes")
}

// -----------------------------------------------------------------------------
// Warehouses & inventory
// -----------------------------------------------------------------------------

model Warehouse {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique // WH-001
  name                String
  addressLine1        String       @map("address_line1")
  addressLine2        String?      @map("address_line2")
  city                String
  state               String
  stateCode           String       @map("state_code")
  postalCode          String       @map("postal_code")
  country             String       @default("IN")
  contactName         String?      @map("contact_name")
  contactPhone        String?      @map("contact_phone")
  contactEmail        String?      @map("contact_email")
  gstin               String?
  status              ActiveStatus @default(ACTIVE)
  isOnlineFulfillment Boolean      @default(true) @map("is_online_fulfillment")
  priority            Int          @default(100) // lower = preferred for online allocation
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  locations       WarehouseLocation[]
  inventoryLevels InventoryLevel[]
  inventoryTxns   InventoryTransaction[]
  reservations    StockReservation[]
  adjustments     StockAdjustment[]
  transfersOut    StockTransfer[]        @relation("TransferFrom")
  transfersIn     StockTransfer[]        @relation("TransferTo")
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  orderItems      OrderItem[]
  orders          Order[]
  posCarts        PosCart[]
  shipments       Shipment[]
  staff           User[]
  returnItems     ReturnItem[]

  @@index([status])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  code        String // e.g. A-01-03 (aisle-rack-bin)
  name        String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

// One row per (variant, warehouse). available = on_hand - reserved.
// CHECK constraints (see migration) keep reserved/damaged/returned >= 0.
model InventoryLevel {
  id                String   @id @default(uuid()) @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  locationId        String?  @map("location_id") @db.Uuid // default bin
  onHand            Int      @default(0) @map("on_hand") // physical sellable units (includes reserved)
  reserved          Int      @default(0)
  damaged           Int      @default(0)
  returned          Int      @default(0) // returned units awaiting inspection
  lowStockThreshold Int?     @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_levels")
}

// Append-only stock ledger. Never updated, never deleted.
model InventoryTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  variantId       String                @map("variant_id") @db.Uuid
  warehouseId     String                @map("warehouse_id") @db.Uuid
  sku             String
  type            InventoryMovementType
  bucket          StockBucket
  quantity        Int // signed delta applied to the bucket
  balanceBefore   Int                   @map("balance_before")
  balanceAfter    Int                   @map("balance_after")
  referenceType   String?               @map("reference_type") // ORDER, GOODS_RECEIPT, TRANSFER, ADJUSTMENT, RETURN, POS
  referenceId     String?               @map("reference_id")
  referenceNumber String?               @map("reference_number")
  userId          String?               @map("user_id") @db.Uuid
  notes           String?
  createdAt       DateTime              @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String?           @map("order_id") @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime          @map("expires_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  order     Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([orderId])
  @@map("stock_reservations")
}

model StockAdjustment {
  id          String           @id @default(uuid()) @db.Uuid
  number      String           @unique
  warehouseId String           @map("warehouse_id") @db.Uuid
  reason      AdjustmentReason
  notes       String?
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     StockAdjustmentItem[]

  @@index([warehouseId, createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id            String      @id @default(uuid()) @db.Uuid
  adjustmentId  String      @map("adjustment_id") @db.Uuid
  variantId     String      @map("variant_id") @db.Uuid
  bucket        StockBucket
  quantityDelta Int         @map("quantity_delta")
  balanceBefore Int         @map("balance_before")
  balanceAfter  Int         @map("balance_after")

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@map("stock_adjustment_items")
}

model StockTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  number          String         @unique
  fromWarehouseId String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String         @map("to_warehouse_id") @db.Uuid
  status          TransferStatus @default(DRAFT)
  notes           String?
  createdById     String?        @map("created_by_id") @db.Uuid
  dispatchedAt    DateTime?      @map("dispatched_at")
  receivedAt      DateTime?      @map("received_at")
  cancelledAt     DateTime?      @map("cancelled_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  items         StockTransferItem[]

  @@index([status, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String @id @default(uuid()) @db.Uuid
  transferId       String @map("transfer_id") @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  quantity         Int
  receivedQuantity Int    @default(0) @map("received_quantity")

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, variantId])
  @@map("stock_transfer_items")
}

// -----------------------------------------------------------------------------
// Suppliers & purchasing
// -----------------------------------------------------------------------------

model Supplier {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  name             String
  companyName      String?      @map("company_name")
  contactPerson    String?      @map("contact_person")
  phone            String?
  email            String?
  gstin            String?
  addressLine1     String?      @map("address_line1")
  addressLine2     String?      @map("address_line2")
  city             String?
  state            String?
  stateCode        String?      @map("state_code")
  postalCode       String?      @map("postal_code")
  country          String       @default("IN")
  paymentTermsDays Int?         @map("payment_terms_days")
  paymentTerms     String?      @map("payment_terms")
  status           ActiveStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  number               String              @unique
  supplierId           String              @map("supplier_id") @db.Uuid
  warehouseId          String              @map("warehouse_id") @db.Uuid
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  subtotal             Int                 @default(0)
  taxTotal             Int                 @default(0) @map("tax_total")
  shippingCost         Int                 @default(0) @map("shipping_cost")
  grandTotal           Int                 @default(0) @map("grand_total")
  notes                String?
  createdById          String?             @map("created_by_id") @db.Uuid
  approvedById         String?             @map("approved_by_id") @db.Uuid
  submittedAt          DateTime?           @map("submitted_at")
  approvedAt           DateTime?           @map("approved_at")
  closedAt             DateTime?           @map("closed_at")
  cancelledAt          DateTime?           @map("cancelled_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(uuid()) @db.Uuid
  purchaseOrderId  String @map("purchase_order_id") @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  sku              String
  description      String
  quantityOrdered  Int    @map("quantity_ordered")
  quantityReceived Int    @default(0) @map("quantity_received")
  unitCost         Int    @map("unit_cost")
  taxRateBps       Int    @default(0) @map("tax_rate_bps")
  taxAmount        Int    @default(0) @map("tax_amount")
  lineTotal        Int    @map("line_total")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@unique([purchaseOrderId, variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  number          String   @unique
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  receivedById    String?  @map("received_by_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String @id @default(uuid()) @db.Uuid
  goodsReceiptId      String @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String @map("purchase_order_item_id") @db.Uuid
  variantId           String @map("variant_id") @db.Uuid
  quantityReceived    Int    @map("quantity_received") // good units -> on_hand
  quantityDamaged     Int    @default(0) @map("quantity_damaged") // -> damaged bucket

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

// -----------------------------------------------------------------------------
// Cart & wishlist
// -----------------------------------------------------------------------------

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token")
  couponCode String?  @map("coupon_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

enum ReviewStatus {
  PENDING // waiting for a moderator
  PUBLISHED // shown on the product page
  REJECTED // kept for the record, never shown
}

/// A customer's rating and review of a product they received. Only customers
/// with a delivered order for the product may write one, and each customer has
/// at most one review per product (they can edit it).
model ProductReview {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  orderId        String?      @map("order_id") @db.Uuid // the delivered order that made the customer eligible
  rating         Int // 1 to 5 (CHECK constraint in the migration)
  title          String?
  comment        String?
  authorName     String       @map("author_name") // as shown publicly, e.g. "Asha R."
  variantTitle   String?      @map("variant_title") // what they bought, e.g. "Red / M"
  status         ReviewStatus @default(PENDING)
  moderatedById  String?      @map("moderated_by_id") @db.Uuid
  moderatedAt    DateTime?    @map("moderated_at")
  moderationNote String?      @map("moderation_note") // internal: why it was rejected
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@map("product_reviews")
}

// -----------------------------------------------------------------------------
// Coupons & automatic discounts
// -----------------------------------------------------------------------------

model Coupon {
  id                String        @id @default(uuid()) @db.Uuid
  code              String        @unique @db.Citext
  description       String?
  discountType      DiscountType  @map("discount_type")
  value             Int // bps for PERCENTAGE, paise for FIXED
  minOrderAmount    Int?          @map("min_order_amount")
  maxDiscountAmount Int?          @map("max_discount_amount")
  startsAt          DateTime?     @map("starts_at")
  expiresAt         DateTime?     @map("expires_at")
  usageLimit        Int?          @map("usage_limit")
  perUserLimit      Int?          @map("per_user_limit")
  usedCount         Int           @default(0) @map("used_count")
  scope             DiscountScope @default(ALL) // ALL | PRODUCTS | CATEGORIES
  channel           ChannelScope  @default(ALL)
  isActive          Boolean       @default(true) @map("is_active")
  isPublic          Boolean       @default(false) @map("is_public") // listed on the storefront coupons page
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  products    CouponProduct[]
  categories  CouponCategory[]
  redemptions CouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponProduct {
  couponId  String @map("coupon_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String @map("coupon_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

// One redemption per order. Counted towards limits while ACTIVE or CONFIRMED;
// released (CANCELLED) when an unpaid order expires or is cancelled.
model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  discountAmount Int      @map("discount_amount")
  status         String   @default("ACTIVE") // ACTIVE | CONFIRMED | CANCELLED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, status])
  @@index([couponId, userId, status])
  @@map("coupon_redemptions")
}

// Automatic price rules (e.g. "20% off Tops this weekend"). The single best
// applicable discount is applied per line; discounts do not stack.
model Discount {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  discountType DiscountType  @map("discount_type")
  value        Int
  scope        DiscountScope @default(ALL)
  channel      ChannelScope  @default(ALL)
  startsAt     DateTime?     @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  isActive     Boolean       @default(true) @map("is_active")
  priority     Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  targets DiscountTarget[]

  @@index([isActive, startsAt, endsAt])
  @@map("discounts")
}

model DiscountTarget {
  id         String  @id @default(uuid()) @db.Uuid
  discountId String  @map("discount_id") @db.Uuid
  productId  String? @map("product_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid

  discount Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([discountId])
  @@index([productId])
  @@index([categoryId])
  @@index([brandId])
  @@map("discount_targets")
}

// -----------------------------------------------------------------------------
// Orders
// -----------------------------------------------------------------------------

model Order {
  id                   String         @id @default(uuid()) @db.Uuid
  orderNumber          String         @unique @map("order_number")
  channel              SalesChannel   @default(ONLINE)
  userId               String?        @map("user_id") @db.Uuid
  customerName         String?        @map("customer_name")
  customerEmail        String?        @map("customer_email")
  customerPhone        String?        @map("customer_phone")
  status               OrderStatus    @default(PENDING)
  paymentStatus        PaymentStatus  @default(CREATED) @map("payment_status")
  shippingStatus       ShipmentStatus @default(PENDING) @map("shipping_status")
  currency             String         @default("INR")
  subtotal             Int // sum of (unit price * qty) before any discount
  discountTotal        Int            @default(0) @map("discount_total")
  taxTotal             Int            @default(0) @map("tax_total")
  shippingTotal        Int            @default(0) @map("shipping_total")
  roundOff             Int            @default(0) @map("round_off")
  grandTotal           Int            @map("grand_total")
  amountRefunded       Int            @default(0) @map("amount_refunded")
  pricesIncludeTax     Boolean        @map("prices_include_tax")
  sellerStateCode      String         @map("seller_state_code")
  placeOfSupply        String         @map("place_of_supply") // state code
  couponId             String?        @map("coupon_id") @db.Uuid
  couponCode           String?        @map("coupon_code")
  billingAddress       Json?          @map("billing_address")
  shippingAddress      Json?          @map("shipping_address")
  warehouseId          String?        @map("warehouse_id") @db.Uuid // POS billing location
  notes                String?
  cancelReason         String?        @map("cancel_reason")
  idempotencyKey       String?        @unique @map("idempotency_key")
  createdById          String?        @map("created_by_id") @db.Uuid // cashier for POS
  reservationExpiresAt DateTime?      @map("reservation_expires_at")
  placedAt             DateTime       @default(now()) @map("placed_at")
  confirmedAt          DateTime?      @map("confirmed_at")
  cancelledAt          DateTime?      @map("cancelled_at")
  deliveredAt          DateTime?      @map("delivered_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  user             User?                @relation("CustomerOrders", fields: [userId], references: [id], onDelete: SetNull)
  createdBy        User?                @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  warehouse        Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  reviews          ProductReview[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  refunds          Refund[]
  reservations     StockReservation[]
  invoice          Invoice?
  creditNotes      CreditNote[]
  shipments        Shipment[]
  returnRequests   ReturnRequest[]
  couponRedemption CouponRedemption?
  posCart          PosCart?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([channel, createdAt])
  @@index([createdAt])
  @@index([reservationExpiresAt])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  sku              String
  productName      String   @map("product_name")
  variantTitle     String   @map("variant_title")
  hsnCode          String?  @map("hsn_code")
  imageUrl         String?  @map("image_url")
  quantity         Int
  mrp              Int // unit list price
  unitPrice        Int      @map("unit_price") // unit selling price before discounts
  discountAmount   Int      @default(0) @map("discount_amount") // line total discount (auto + coupon + manual)
  taxableAmount    Int      @map("taxable_amount")
  taxRateBps       Int      @map("tax_rate_bps")
  cgstAmount       Int      @default(0) @map("cgst_amount")
  sgstAmount       Int      @default(0) @map("sgst_amount")
  igstAmount       Int      @default(0) @map("igst_amount")
  taxAmount        Int      @map("tax_amount")
  lineTotal        Int      @map("line_total") // taxable + tax
  returnedQuantity Int      @default(0) @map("returned_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  note        String?
  changedById String?      @map("changed_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// -----------------------------------------------------------------------------
// Payments, refunds & webhooks
// -----------------------------------------------------------------------------

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider
  method            String? // card, upi, netbanking, cash, ...
  status            PaymentStatus   @default(CREATED)
  amount            Int
  currency          String          @default("INR")
  amountRefunded    Int             @default(0) @map("amount_refunded")
  razorpayOrderId   String?         @unique @map("razorpay_order_id")
  razorpayPaymentId String?         @unique @map("razorpay_payment_id")
  razorpaySignature String?         @map("razorpay_signature")
  referenceNumber   String?         @map("reference_number") // UPI ref / card slip for manual POS payments
  failureReason     String?         @map("failure_reason")
  receivedById      String?         @map("received_by_id") @db.Uuid
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  refundNumber     String       @unique @map("refund_number")
  paymentId        String       @map("payment_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  returnRequestId  String?      @map("return_request_id") @db.Uuid
  amount           Int
  status           RefundStatus @default(PENDING)
  razorpayRefundId String?      @unique @map("razorpay_refund_id")
  reason           String?
  failureReason    String?      @map("failure_reason")
  idempotencyKey   String       @unique @map("idempotency_key")
  initiatedById    String?      @map("initiated_by_id") @db.Uuid
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  creditNote    CreditNote?

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

model WebhookEvent {
  id             String        @id @default(uuid()) @db.Uuid
  provider       String // RAZORPAY | SHIPROCKET
  eventId        String        @map("event_id")
  eventType      String        @map("event_type")
  payload        Json
  signatureValid Boolean       @map("signature_valid")
  status         WebhookStatus @default(RECEIVED)
  attempts       Int           @default(0)
  error          String?
  receivedAt     DateTime      @default(now()) @map("received_at")
  processedAt    DateTime?     @map("processed_at")

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// -----------------------------------------------------------------------------
// Billing: invoices, credit notes, number sequences
// -----------------------------------------------------------------------------

// Immutable once issued (enforced by a database trigger, see migration).
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number")
  orderId         String        @unique @map("order_id") @db.Uuid
  status          InvoiceStatus @default(ISSUED)
  financialYear   String        @map("financial_year") // e.g. 2026-27
  issuedAt        DateTime      @default(now()) @map("issued_at")
  seller          Json // name, gstin, address at time of issue
  buyer           Json // name, email, phone, gstin?
  billingAddress  Json?         @map("billing_address")
  shippingAddress Json?         @map("shipping_address")
  lines           Json // frozen line items incl. tax split
  placeOfSupply   String        @map("place_of_supply")
  subtotal        Int
  discountTotal   Int           @map("discount_total")
  taxableTotal    Int           @map("taxable_total")
  cgstTotal       Int           @map("cgst_total")
  sgstTotal       Int           @map("sgst_total")
  igstTotal       Int           @map("igst_total")
  shippingTotal   Int           @map("shipping_total")
  roundOff        Int           @map("round_off")
  grandTotal      Int           @map("grand_total")
  paymentMethod   String        @map("payment_method")
  paymentStatus   PaymentStatus @map("payment_status")
  pdfKey          String?       @map("pdf_key")
  cancelledAt     DateTime?     @map("cancelled_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creditNotes CreditNote[]

  @@index([issuedAt])
  @@map("invoices")
}

model CreditNote {
  id               String   @id @default(uuid()) @db.Uuid
  creditNoteNumber String   @unique @map("credit_note_number")
  invoiceId        String   @map("invoice_id") @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  refundId         String?  @unique @map("refund_id") @db.Uuid
  reason           String?
  lines            Json
  taxableTotal     Int      @map("taxable_total")
  cgstTotal        Int      @map("cgst_total")
  sgstTotal        Int      @map("sgst_total")
  igstTotal        Int      @map("igst_total")
  total            Int
  issuedAt         DateTime @default(now()) @map("issued_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund  Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("credit_notes")
}

// Gap-free document numbering. Rows are locked with SELECT ... FOR UPDATE.
model DocumentSequence {
  key       String   @id // e.g. "INV:2026-27", "ORD:20261008"
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("document_sequences")
}

// -----------------------------------------------------------------------------
// Shipping
// -----------------------------------------------------------------------------

model Shipment {
  id                  String         @id @default(uuid()) @db.Uuid
  orderId             String         @map("order_id") @db.Uuid
  warehouseId         String         @map("warehouse_id") @db.Uuid
  returnRequestId     String?        @map("return_request_id") @db.Uuid
  isReturn            Boolean        @default(false) @map("is_return")
  provider            String // SHIPROCKET | MOCK | MANUAL
  providerOrderId     String?        @map("provider_order_id")
  providerShipmentId  String?        @map("provider_shipment_id")
  awb                 String?        @unique
  courierName         String?        @map("courier_name")
  courierId           String?        @map("courier_id")
  trackingUrl         String?        @map("tracking_url")
  labelUrl            String?        @map("label_url")
  status              ShipmentStatus @default(PENDING)
  pickupStatus        String?        @map("pickup_status")
  shippingCost        Int?           @map("shipping_cost") // what the courier charges us
  weightGrams         Int?           @map("weight_grams")
  estimatedDeliveryAt DateTime?      @map("estimated_delivery_at")
  pickedUpAt          DateTime?      @map("picked_up_at")
  deliveredAt         DateTime?      @map("delivered_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  lastSyncedAt        DateTime?      @map("last_synced_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest?  @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  events        ShipmentEvent[]

  @@index([orderId])
  @@index([providerShipmentId])
  @@index([status, updatedAt])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @map("shipment_id") @db.Uuid
  status      ShipmentStatus
  rawStatus   String         @map("raw_status")
  location    String?
  description String?
  occurredAt  DateTime       @map("occurred_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, rawStatus, occurredAt])
  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// -----------------------------------------------------------------------------
// Returns
// -----------------------------------------------------------------------------

model ReturnRequest {
  id            String       @id @default(uuid()) @db.Uuid
  returnNumber  String       @unique @map("return_number")
  orderId       String       @map("order_id") @db.Uuid
  userId        String?      @map("user_id") @db.Uuid
  status        ReturnStatus @default(REQUESTED)
  reason        String
  customerNotes String?      @map("customer_notes")
  adminNotes    String?      @map("admin_notes")
  processedById String?      @map("processed_by_id") @db.Uuid
  requestedAt   DateTime     @default(now()) @map("requested_at")
  approvedAt    DateTime?    @map("approved_at")
  receivedAt    DateTime?    @map("received_at")
  closedAt      DateTime?    @map("closed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user      User?        @relation("ReturnCustomer", fields: [userId], references: [id], onDelete: SetNull)
  items     ReturnItem[]
  refunds   Refund[]
  shipments Shipment[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id                String           @id @default(uuid()) @db.Uuid
  returnRequestId   String           @map("return_request_id") @db.Uuid
  orderItemId       String           @map("order_item_id") @db.Uuid
  variantId         String           @map("variant_id") @db.Uuid
  quantity          Int
  reason            String?
  condition         ReturnCondition?
  warehouseId       String?          @map("warehouse_id") @db.Uuid // where it was received
  restockedQuantity Int              @default(0) @map("restocked_quantity")
  refundAmount      Int              @default(0) @map("refund_amount")

  returnRequest ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_items")
}

// -----------------------------------------------------------------------------
// POS (in-store billing)
// -----------------------------------------------------------------------------

model PosCart {
  id                   String        @id @default(uuid()) @db.Uuid
  warehouseId          String        @map("warehouse_id") @db.Uuid
  cashierId            String        @map("cashier_id") @db.Uuid
  customerId           String?       @map("customer_id") @db.Uuid
  customerName         String?       @map("customer_name")
  customerPhone        String?       @map("customer_phone")
  customerEmail        String?       @map("customer_email")
  status               PosCartStatus @default(OPEN)
  couponCode           String?       @map("coupon_code")
  manualDiscount       Int           @default(0) @map("manual_discount") // bill-level, paise
  manualDiscountReason String?       @map("manual_discount_reason")
  orderId              String?       @unique @map("order_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items     PosCartItem[]

  @@index([cashierId, status])
  @@map("pos_carts")
}

// Prices on POS cart lines are informative snapshots only; every checkout
// recalculates price, tax and discount on the server.
model PosCartItem {
  id             String   @id @default(uuid()) @db.Uuid
  posCartId      String   @map("pos_cart_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  sku            String
  quantity       Int
  unitPrice      Int      @map("unit_price")
  discountAmount Int      @default(0) @map("discount_amount")
  manualDiscount Int      @default(0) @map("manual_discount")
  taxAmount      Int      @default(0) @map("tax_amount")
  lineTotal      Int      @default(0) @map("line_total")
  stockOverride  Boolean  @default(false) @map("stock_override")
  addedById      String?  @map("added_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  posCart PosCart        @relation(fields: [posCartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([posCartId, variantId])
  @@map("pos_cart_items")
}

// -----------------------------------------------------------------------------
// Notifications
// -----------------------------------------------------------------------------

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String?             @map("user_id") @db.Uuid
  channel           NotificationChannel
  template          String
  recipient         String? // email / phone; null for IN_APP
  subject           String?
  title             String?
  body              String?
  payload           Json?
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error")
  providerMessageId String?             @map("provider_message_id")
  idempotencyKey    String?             @unique @map("idempotency_key")
  readAt            DateTime?           @map("read_at")
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, channel, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model SmsLog {
  id                String   @id @default(uuid()) @db.Uuid
  notificationId    String?  @map("notification_id") @db.Uuid
  phone             String
  template          String
  body              String // OTP values are masked before storage
  provider          String
  providerMessageId String?  @map("provider_message_id")
  status            String
  error             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([createdAt])
  @@map("sms_logs")
}

model EmailLog {
  id                String   @id @default(uuid()) @db.Uuid
  notificationId    String?  @map("notification_id") @db.Uuid
  to                String
  subject           String
  template          String
  provider          String
  providerMessageId String?  @map("provider_message_id")
  status            String
  error             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([to, createdAt])
  @@index([createdAt])
  @@map("email_logs")
}

// -----------------------------------------------------------------------------
// Platform: audit, settings, idempotency
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String // e.g. product.update, inventory.adjust
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  scope        String // "<userId>:<route>"
  key          String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  createdAt    DateTime          @default(now()) @map("created_at")
  expiresAt    DateTime          @map("expires_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
